# Copy to .env. Fill each blank locally. Never commit .env, private keys, or passwords.
# Generate distinct URL-safe passwords (see README).
POSTGRES_PASSWORD=
_AIRFLOW_WWW_USER_PASSWORD=
FERNET_KEY=

# Path to the dedicated Snowflake private key file on your host, not the container.
# Prefer an absolute path; forward slashes work in Windows Docker Desktop paths.
SNOWFLAKE_KEY_HOST_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=STUDENT
SNOWFLAKE_WAREHOUSE=STUDENT_WH
SNOWFLAKE_DATABASE=PROJECT_DB
SNOWFLAKE_SCHEMA=RAW

# Trusted server PUBLIC keys supplied by your instructor/admin, not your own keys.
# Format inside quotes: "key-type base64-data".
SSH_HOST_KEY=
SFTP_HOST_KEY=
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_DIR=
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=
MONGO_COLLECTION=
